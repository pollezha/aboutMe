{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Bots": {
    "UserAgents": [ "bot", "crawler", "spider", "Googlebot", "bingbot", "YandexBot", "Lighthouse", "HeadlessChrome" ]
  },
  "RateLimits": {
    "Events": { "PermitLimit": 60, "Window": "00:01:00" },
    "Messages": { "PermitLimit": 3, "Window": "01:00:00" },
    "Hubs": { "PermitLimit": 3 }
  },
  "Health": {
    "AllowedHosts": [ "localhost", "gateway", "127.0.0.1" ],
    "Timeout": "00:00:02",
    "CacheDuration": "00:00:05",
    "Backends": {
      "content-api": "http://content-api/health",
      "events-api": "http://events-api/health",
      "live-hub": "http://live-hub/health",
      "projector": "http://projector/health"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "content": {
        "ClusterId": "content-api",
        "Match": { "Path": "/api/content/{**rest}", "Methods": [ "GET" ] }
      },
      "events": {
        "ClusterId": "events-api",
        "RateLimiterPolicy": "events",
        "MaxRequestBodySize": 16384,
        "Match": { "Path": "/api/events", "Methods": [ "POST" ] }
      },
      "messages": {
        "ClusterId": "events-api",
        "RateLimiterPolicy": "messages",
        "MaxRequestBodySize": 4096,
        "Match": { "Path": "/api/messages", "Methods": [ "POST" ] }
      },
      "hubs": {
        "ClusterId": "live-hub",
        "RateLimiterPolicy": "hubs",
        "Match": { "Path": "/hubs/live/{**rest}" }
      }
    },
    "Clusters": {
      "content-api": {
        "Destinations": { "default": { "Address": "https+http://content-api" } }
      },
      "events-api": {
        "Destinations": { "default": { "Address": "https+http://events-api" } }
      },
      "live-hub": {
        "Destinations": { "default": { "Address": "https+http://live-hub" } }
      }
    }
  }
}

<Project>
  <PropertyGroup>
    <!-- Позволяет поднять уязвимую транзитивную зависимость без прямой ссылки -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ServiceDefaults -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <!-- Kafka: обёртка проброса trace context и общий конфиг (ADR-0002, E4-T0) -->
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <!-- AppHost: транзитивно из Aspire.Hosting 13.6.1; 2.5.302 уязвима (GHSA-qhrr-8q5h-9q3h) -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />
    <!-- Kafka-клиент с health check и OTel-метриками (live-hub, events-api, projector) -->
    <PackageVersion Include="Aspire.Confluent.Kafka" Version="13.6.1" />
    <!-- Gateway -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
    <!-- Projector: EF Core + PostgreSQL (клиентская интеграция Aspire даёт health check и OTel) -->
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- BuildingBlocks/Persistence: EfUnitOfWork без привязки к провайдеру; версия = транзитивная из Npgsql EF 10.0.3 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- AppHost: PostgreSQL и Kafka как ресурсы (локальный запуск, AppHost-тест) -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="13.6.1" />
    <!-- Tests -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Kafka" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>

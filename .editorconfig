root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,py}]
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# namespace = путь папки (ADR-0007): <Svc>.<Layer>[.<Feature>]
dotnet_style_namespace_match_folder = true
# TODO R8: включить, когда src/ServiceDefaults/Extensions.cs уйдёт с шаблонного namespace Microsoft.Extensions.Hosting
# dotnet_diagnostic.IDE0130.severity = warning

# Тесты: имена вида Метод_делает_что_то читаются лучше
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

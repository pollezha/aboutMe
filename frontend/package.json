{
  "name": "aboutme-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "validate:content": "node scripts/validate-content.mjs",
    "prebuild": "npm run validate:content",
    "build": "vue-tsc -b && vite-ssg build",
    "postbuild": "npm run size",
    "size": "size-limit",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:theme": "node scripts/gen-theme.mjs",
    "shots": "node scripts/shots.mjs",
    "test": "vitest run",
    "og": "node scripts/og.mjs",
    "island": "node scripts/island.mjs",
    "cv": "node scripts/cv.mjs"
  },
  "size-limit": [
    {
      "name": "main JS (gzip)",
      "path": "dist/assets/app-*.js",
      "limit": "150 kB",
      "gzip": true
    },
    {
      "name": "3D scene chunk (raw)",
      "path": "dist/assets/Scene-*.js",
      "limit": "2 MB",
      "gzip": false,
      "brotli": false
    }
  ],
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tresjs/cientos": "^5.10.0",
    "@tresjs/core": "^5.10.0",
    "@unhead/vue": "^2.1.17",
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}

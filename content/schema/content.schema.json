{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pollezha/aboutMe/content/schema/content.schema.json",
  "title": "Site content bundle (one language)",
  "description": "Source of truth for site texts (ADR-0004). Chapters and skills are added in stage 3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contentVersion", "lang", "profile"],
  "properties": {
    "$schema": { "type": "string" },
    "contentVersion": {
      "description": "Monotonic content version (UTC time of the content commit); the frontend swaps its snapshot only for a newer one",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "lang": { "enum": ["en", "ru"] },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "status", "workFormat", "links"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "workFormat": { "$ref": "#/$defs/text" },
        "location": { "$ref": "#/$defs/text" },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/link" }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "href"],
      "properties": {
        "kind": {
          "enum": ["github", "telegram", "hh", "linkedin", "email", "cv"]
        },
        "label": { "$ref": "#/$defs/text" },
        "href": { "type": "string", "pattern": "^(https://|mailto:|/)" }
      }
    }
  }
}
